---
import { url } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileContactBar from '../components/MobileContactBar.astro';
import { site } from '../data/site';
import ogDefault from '../assets/photos/tartine-tomates-carottes.jpg';
import { getImage } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = site.description, image = ogDefault, noindex: noindexPage = false, jsonLd } = Astro.props;
const noindex = noindexPage || import.meta.env.PUBLIC_NOINDEX === 'true';
const fullTitle = title ? `${title} — ${site.name}, ${site.title} à ${site.city}` : `${site.name} — ${site.title} à ${site.city}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);

const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${site.name} — ${site.title}`,
  description: site.description,
  url: Astro.site?.toString(),
  telephone: '+32456587970',
  email: site.email,
  areaServed: 'Mons, Hainaut, Belgique',
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'BE' },
  sameAs: [site.instagram, site.facebook],
};
const ld = [business, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="fr-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#0b5550" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content={`${site.name} — ${site.title}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <MobileContactBar />
  </body>
</html>
